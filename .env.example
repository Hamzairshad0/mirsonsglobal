# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.mirsonsglobal.com

# ---- Database ----
# Local development uses a SQLite file. In production (Vercel) use a free Turso database:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-token
# (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, as set by the Vercel Turso integration, also work.)
DATABASE_URL=file:data/mirsons.db
DATABASE_AUTH_TOKEN=

# ---- Admin access (/admin) ----
ADMIN_PASSWORD=change-this-to-a-long-password
# Random 32+ character string used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string

# ---- Email (your professional business mailbox SMTP) ----
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@mirsonsglobal.com
SMTP_PASS=
EMAIL_FROM="Mirsons Global <info@mirsonsglobal.com>"
# Team inbox(es) that receive new-inquiry alerts (comma separated)
NOTIFY_EMAIL=info@mirsonsglobal.com

# ---- Analytics (optional, privacy-friendly) ----
# Plausible: set your domain. Or Google Analytics 4: set the measurement ID.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
